{
    "name": "lukasmu/loewen",
    "type": "project",
    "description": "Website of Musikverein \"Musikalische Löwen\" Nentershausen",
    "keywords": [
        "loewen",
        "musikverein",
        "nentershausen",
        "laravel"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Lukas Müller",
            "email": "hello@lukasmu.com",
            "homepage": "https://lukasmu.com",
            "role": "Developer"
        },
        {
            "name": "Pascal Zänglere",
            "email": "trompete2@yahoo.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^7.3|^8.0",
        "ext-curl": "*",
        "fideloper/proxy": "^4.4",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "intervention/validation": "^2.6",
        "laravel/framework": "^8.12",
        "laravel/tinker": "^2.5",
        "lukasmu/laravel-rickroll": "^1.0.2",
        "pgrimaud/instagram-user-feed": "^6.6",
        "spatie/laravel-honeypot": "^3.0"
    },
    "require-dev": {
        "ext-dom": "*",
        "ext-libxml": "*",
        "facade/ignition": "^2.5",
        "fakerphp/faker": "^1.9.1",
        "laravel/dusk": "^6.11",
        "laravel/sail": "^1.0.1",
        "laravel/telescope": "^4.4",
        "mockery/mockery": "^1.4.2",
        "mxl/laravel-job": "^1.2",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^9.3.3",
        "squizlabs/php_codesniffer": "^3.5"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r \"new SQLite3('database/database.sqlite');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan storage:link"
        ],
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes"
    }
}
