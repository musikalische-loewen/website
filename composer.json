{
    "name": "lukasmu/loewen",
    "type": "project",
    "description": "Website of Musikverein \"Musikalische Löwen\" Nentershausen",
    "keywords": [
        "loewen",
        "musikverein",
        "nentershausen",
        "laravel"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Lukas Müller",
            "email": "hello@lukasmu.com",
            "homepage": "https://lukasmu.com",
            "role": "Developer"
        },
        {
            "name": "Pascal Zänglere",
            "email": "trompete2@yahoo.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "guzzlehttp/guzzle": "^7.2",
        "intervention/validation": "^4.7",
        "laravel/framework": "^13.39",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "mxl/laravel-job": "^1.8",
        "nesbot/carbon": "^3.15",
        "pgrimaud/instagram-user-feed": "^6.6",
        "phpoffice/phpspreadsheet": "^5.10",
        "spatie/laravel-honeypot": "^4.7",
        "spatie/laravel-stripe-webhooks": "^3.12",
        "stripe/stripe-php": "^10.12"
    },
    "require-dev": {
        "ext-bcmath": "*",
        "ext-dom": "*",
        "ext-libxml": "*",
        "deployer/deployer": "^7.0",
        "fakerphp/faker": "^1.24",
        "laravel/dusk": "^8.7",
        "laravel/pint": "^1.25",
        "laravel/sail": "^1.46",
        "laravel/telescope": "^5.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^12.0",
        "spatie/laravel-ignition": "^2.12",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r \"new SQLite3('database/database.sqlite');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan storage:link"
        ],
        "post-update-cmd": [
            "@php artisan telescope:publish --ansi",
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "style-test": "vendor/bin/phpcs",
        "style-fix": "vendor/bin/phpcbf"
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
