{
    "private": true,
    "scripts": {
        "dev": "npm run development",
        "development": "mix",
        "watch": "mix watch",
        "watch-poll": "mix watch -- --watch-options-poll=1000",
        "hot": "mix watch --hot",
        "prod": "npm run production",
        "production": "mix --production",
        "sharp": "npm run sharp-large && npm run sharp-medium && npm run sharp-small && npm run sharp-logos",
        "sharp-large": "sharp -i resources/images/archive/*.jpg -o public/images/archive/large -q 90 -- resize 1920",
        "sharp-medium": "sharp -i resources/images/archive/*.jpg -o public/images/archive/medium -q 90 -- resize 1080",
        "sharp-small": "sharp -i resources/images/archive/*.jpg -o public/images/archive/small -q 90 -- resize 640",
        "sharp-logos": "sharp -i resources/images/logos/*.png -o public/images/logos -q 90 -- resize 195"
    },
    "devDependencies": {
        "@fortawesome/fontawesome-free": "^5.15.1",
        "@popperjs/core": "^2.6.0",
        "axios": "^0.21",
        "bootstrap": "^5.0.0-beta1",
        "laravel-mix": "^6.0.6",
        "laravel-mix-purgecss": "^6.0.0",
        "lightgallery.js": "^1.4.0",
        "lodash": "^4.17.19",
        "masonry-layout": "^4.2.2",
        "postcss": "^8.1.14",
        "resolve-url-loader": "^3.1.2",
        "sass": "^1.32.2",
        "sass-loader": "^10.1.0",
        "sharp-cli": "^1.14.1"
    }
}
